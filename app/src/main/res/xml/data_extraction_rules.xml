<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device. The token's Keystore key can't be copied, and the local
     database is rebuilt by the first sync after signing in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
